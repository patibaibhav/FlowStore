# ---- Amazon S3 (REQUIRED) -------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET_NAME=                 # your PRIVATE bucket (create it yourself; the app never creates AWS resources)
S3_PREFIX=flowstore
S3_MAX_STORAGE_MB=512           # hard cap on total Parquet bytes the app will upload
S3_UPLOAD_CONCURRENCY=2
S3_UPLOAD_TIMEOUT_SECONDS=30

# Credentials: leave UNSET on EC2 (IAM role / instance profile is used via the default provider chain).
# For local development with real S3 only, you may export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN in your shell. NEVER commit them.

# ---- Local development ONLY: S3-compatible emulator (python backend/scripts/dev_s3.py) --------
# S3_ENDPOINT_URL=http://127.0.0.1:5555

# ---- OPTIONAL: Lambda processor mode ----------------------------------------------
# Leave empty to keep the processor in-process (default). With a function name set, the Experiment
# page offers "Processor runs on: AWS Lambda". The function is created by hand (see docs/AWS_LEARNER_LAB_DEPLOYMENT.md);
# the backend makes no AWS call for this at startup and never falls back silently if Lambda fails.
LAMBDA_PROCESSOR_NAME=
LAMBDA_TIMEOUT_SECONDS=15
LAMBDA_MAX_RETRIES=3
# Development/tests only: run the Lambda handler inside the backend (no AWS). Labelled "emulated" in the UI.
# LAMBDA_EMULATE_LOCAL=true

# ---- OPTIONAL: CloudWatch application metrics (off by default; never used with the S3 emulator) -----
# Publishes at most 10 custom metrics (no dimensions) every N seconds while a run is active.
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NAMESPACE=FlowStore
CLOUDWATCH_INTERVAL_SECONDS=10

# ---- Safety caps (cost control) --------------------------------------------
MAX_RUN_SECONDS=300
MAX_RATE_PER_SECOND=20000
MAX_RECORDS_PER_RUN=500000

# ---- Application -------------------------------------------------------------
DATA_DIR=./data
TELEMETRY_HZ=5
CORS_ORIGINS=http://localhost:5173,http://localhost
# Optional: require this token (X-Admin-Token header) for destructive S3 deletes
ADMIN_TOKEN=

# ---- Cost estimate assumptions (editable; estimates only, not your AWS bill) -----------
PRICE_S3_PUT_PER_1000=0.005
PRICE_S3_GB_MONTH=0.023

# ---- docker compose ------------------------------------------------------------
WEB_PORT=80
BACKEND_MEM_LIMIT=768m
BACKEND_CPUS=1.5
