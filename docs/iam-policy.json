{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFlowStorePrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["flowstore/*", "flowstore"] } }
    },
    {
      "Sid": "ObjectsUnderFlowStorePrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/flowstore/*"
    },
    {
      "Sid": "HeadBucketForHealthCheck",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET"
    }
  ]
}
